APP_ENV=local
LOG_LEVEL=info
HTTP_ADDR=:8080

POSTGRES_DB=cyber_deploy_hub
POSTGRES_USER=cyber
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://cyber:change-me@postgres:5432/cyber_deploy_hub?sslmode=disable
DATABASE_MAX_CONNS=10

NATS_URL=nats://nats:4222

OS_AUTH_URL=https://edu.cyber-infrastructure.ru:5000/v3
OS_USERNAME=
OS_PASSWORD=
OS_USER_DOMAIN_NAME=Hackhaton
OS_PROJECT_ID=
OS_PROJECT_NAME=
OS_PROJECT_DOMAIN_NAME=Hackhaton
OS_REGION_NAME=
OS_ALLOW_REAUTH=true
OS_INSECURE=false
OS_TIMEOUT=20s

KI_API_BASE_URL=https://edu.cyber-infrastructure.ru:8800
KI_PROJECT_ID=
KI_AUTH_TOKEN=
KI_SESSION_COOKIE=
KI_SESSION_ID=1
KI_USERNAME=
KI_PASSWORD=
KI_DOMAIN_NAME=Hackhaton
KI_TIMEOUT=10s

PROJECT_POOL_SEED_FILE=/app/config/project_pool_seed.json
PROJECT_POOL_SEED_JSON=

CAPACITY_THRESHOLD_PERCENT=90
CAPACITY_DEMO_VCPUS=128
CAPACITY_DEMO_VCPUS_FREE=96
CAPACITY_DEMO_RAM_MIB=262144
CAPACITY_DEMO_RAM_FREE_MIB=196608
CAPACITY_DEMO_STORAGE_GIB=4096
CAPACITY_DEMO_STORAGE_USED_GIB=1024

CLOUD_PRIVATE_NETWORK_ID=
CLOUD_PRIVATE_SUBNET_ID=
CLOUD_SECURITY_GROUP_IDS=
CLOUD_BLUEPRINT_FILE=/app/config/lab_blueprints.json
CLOUD_BLUEPRINT_JSON=
CLOUD_KEY_ENCRYPTION_KEY=
CLOUD_KEY_ENCRYPTION_KEY_ID=default
CLOUD_DEPLOY_TIMEOUT=20m
CLOUD_POLL_INTERVAL=5s
CLOUD_DELETE_POLL_INTERVAL=3s
