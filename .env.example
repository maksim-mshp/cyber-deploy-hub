APP_ENV=local
LOG_LEVEL=info
HTTP_ADDR=:8080

POSTGRES_DB=cyber_deploy_hub
POSTGRES_USER=cyber
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://cyber:change-me@postgres:5432/cyber_deploy_hub?sslmode=disable
DATABASE_MAX_CONNS=10

NATS_URL=nats://nats:4222

OS_AUTH_URL=https://edu.cyber-infrastructure.ru:5000/v3
OS_USERNAME=
OS_PASSWORD=
OS_USER_DOMAIN_NAME=Hackhaton
OS_PROJECT_ID=
OS_PROJECT_NAME=
OS_PROJECT_DOMAIN_NAME=Hackhaton
OS_REGION_NAME=
OS_ALLOW_REAUTH=true
OS_INSECURE=false
OS_TIMEOUT=20s

KI_API_BASE_URL=https://edu.cyber-infrastructure.ru:8800
KI_PROJECT_ID=
KI_AUTH_TOKEN=
KI_TIMEOUT=10s

PROJECT_POOL_SEED_FILE=/app/config/project_pool_seed.json
